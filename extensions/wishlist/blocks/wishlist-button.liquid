<button
  type="button"
  class="wishora-button"
  data-wishora-product="{{ product.id }}"
  aria-label="Add to wishlist"
>
  ♡
</button>

<style>
  .wishora-button {
    width: 40px;
    height: 40px;
    border: 0;
    background: white;
    border-radius: 50%;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
  }

  .wishora-button.wishora-active {
    color: red;
  }
</style>

{% schema %}
{
  "name": "Wishlist button",
  "target": "section",
  "settings": []
}
{% endschema %}