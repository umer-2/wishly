<button
  type="button"
  class="wishora-button"
  data-wishora-product="{{ product.id }}"
  data-wishora-handle="{{ product.handle }}"
  aria-label="Add to wishlist"
>
  <span class="wishora-heart" aria-hidden="true">♡</span>
</button>

<style>
  .wishora-button {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(20, 32, 43, 0.14);
    background: rgba(255, 255, 255, 0.94);
    border-radius: 50%;
    cursor: pointer;
    color: #263746;
    font-size: 22px;
    line-height: 1;
    box-shadow: 0 3px 12px rgba(20, 32, 43, 0.1);
    transition: transform 160ms ease, color 160ms ease, background 160ms ease;
  }

  .wishora-button:hover {
    transform: translateY(-2px);
    background: #fff;
  }

  .wishora-button.wishora-active {
    color: #c7473b;
    background: #fff1ed;
    border-color: #f3c2b8;
  }
</style>

{% schema %}
{
  "name": "Wishlist button",
  "target": "section",
  "settings": []
}
{% endschema %}