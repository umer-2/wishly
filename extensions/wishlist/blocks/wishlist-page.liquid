<div id="wishora-wishlist-page">
  <h1 class="wishora-title">My Wishlist</h1>

  <div
    id="wishora-products"
    class="wishora-products"
  ></div>
</div>

<style>
  .wishora-title {
    margin-bottom: 30px;
  }

  .wishora-products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .wishora-product {
    position: relative;
  }

  .wishora-product img {
    width: 100%;
    display: block;
  }

  .wishora-product-info {
    padding-top: 12px;
  }

  .wishora-product-title {
    margin: 0 0 5px;
    font-size: 16px;
  }

  .wishora-product-price {
    margin-bottom: 12px;
  }

  .wishora-remove {
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
  }

  @media (max-width: 749px) {
    .wishora-products {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", async function () {
    const container =
      document.getElementById("wishora-products");

    if (!container) {
      return;
    }

    try {
      /*
       * Get wishlist from Wishly
       *
       * Guest:
       * localStorage → Wishly.getWishlist()
       *
       * Logged-in:
       * API → database
       */
      const wishlist =
        await window.Wishly?.getWishlist() || [];

      console.log(
        "Wishly wishlist page:",
        wishlist
      );

      /*
       * Empty wishlist
       */
      if (!wishlist.length) {
        container.innerHTML = `
          <p class="wishora-empty">
            Your wishlist is empty.
          </p>
        `;

        return;
      }

      /*
       * Render wishlist items
       */
      container.innerHTML = wishlist
        .map(function (item) {
          const productId =
            item.productId;

          const handle =
            item.handle || "";

          return `
            <div
              class="wishora-product"
              data-product-id="${productId}"
            >

              <div class="wishora-product-info">

                <h3 class="wishora-product-title">
                  ${handle || "Wishlist Product"}
                </h3>

                <p class="wishora-product-id">
                  Product ID: ${productId}
                </p>

                <button
                  type="button"
                  class="wishora-remove"
                  data-remove-wishora="${productId}"
                >
                  Remove
                </button>

              </div>

            </div>
          `;
        })
        .join("");


      /*
       * Remove product from wishlist
       */
      container.addEventListener(
        "click",
        async function (event) {

          const removeButton =
            event.target.closest(
              "[data-remove-wishora]"
            );

          if (!removeButton) {
            return;
          }

          const productId =
            removeButton.dataset
              .removeWishora;

          if (!productId) {
            return;
          }


          try {

            /*
             * IMPORTANT:
             * Wait for the wishlist operation.
             *
             * Guest:
             * localStorage is updated.
             *
             * Logged-in:
             * API/database is updated.
             */
            if (
              window.Wishly?.removeFromWishlist
            ) {

              await window.Wishly
                .removeFromWishlist(
                  productId
                );
            }


            /*
             * Remove card from page
             */
            const productElement =
              removeButton.closest(
                ".wishora-product"
              );

            if (productElement) {
              productElement.remove();
            }


            /*
             * Check if wishlist is empty
             */
            const remainingProducts =
              container.querySelectorAll(
                ".wishora-product"
              );

            if (
              !remainingProducts.length
            ) {

              container.innerHTML = `
                <p class="wishora-empty">
                  Your wishlist is empty.
                </p>
              `;
            }


            /*
             * Update header counter/buttons
             */
            if (
              window.Wishly?.updateCounter
            ) {
              await window.Wishly
                .updateCounter();
            }

            if (
              window.Wishly?.updateButtons
            ) {
              await window.Wishly
                .updateButtons();
            }


            console.log(
              "Wishly: Removed from wishlist page",
              productId
            );

          } catch (error) {

            console.error(
              "Wishly: Failed to remove wishlist item",
              error
            );

          }

        }
      );

    } catch (error) {

      console.error(
        "Wishly: Failed to load wishlist page",
        error
      );

      container.innerHTML = `
        <p class="wishora-empty">
          Unable to load your wishlist.
        </p>
      `;
    }
  });
</script>

{% schema %}
{
  "name": "Wishlist page",
  "target": "section",
  "settings": []
}
{% endschema %}