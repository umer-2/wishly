<a
  href="/pages/wishlist"
  class="wishora-header"
>
  <span class="wishora-header-icon" aria-hidden="true">♡</span>
  <span data-wishora-counter>0</span>
</a>

<style>
  .wishora-header {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    font-size: 20px;
    line-height: 1;
  }

  .wishora-header-icon {
    transition: color 160ms ease;
  }

  .wishora-header:hover .wishora-header-icon {
    color: #c7473b;
  }

  .wishora-header span {
    position: absolute;
    top: -8px;
    right: -10px;

    min-width: 18px;
    height: 18px;

    border-radius: 50%;

    background: #263746;
    color: white;

    font-size: 11px;

    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

{% schema %}
{
  "name": "Wishlist header",
  "target": "section",
  "settings": []
}
{% endschema %}